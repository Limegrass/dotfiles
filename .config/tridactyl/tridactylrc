colorscheme dark
bind / fillcmdline find
bind ? fillcmdline find -?
bind n findnext 1
bind N findnext -1
bind <C-h> nohlsearch
bind <c-space> fillcmdline tab
unbind --mode=ex <space>
bind --mode=ex <c-j> ex.next_completion
bind --mode=ex <c-k> ex.prev_completion
bind --mode=ex <Tab> ex.insert_space_or_completion
unbind --mode=ex <s-Tab>

autocmd DocStart youtube.com mode ignore
seturl console.aws.amazon.com/cloudwatch superignore true
seturl google.com/maps superignore true

command tabkillall jsb -p browser.tabs.query({url: `*://*.${JS_ARG}/*`}).then(tabs => tabs.forEach(tab => browser.tabs.remove(tab.id)))
command tabkillalltitle jsb -p browser.tabs.query({}).then(tabs => tabs.filter(tab => tab.title.toLowerCase().includes(JS_ARG.toLowerCase())).forEach(tab => browser.tabs.remove(tab.id)))
command tabmoveall jsb -d@ browser.tabs.query({currentWindow: true, url: `*://*.${JS_ARGS[1]}/*`}).then(tabs => browser.tabs.move(tabs.map(tab => tab.id), {index: ["$", "end", undefined].includes(JS_ARGS[2]) ? -1 : ["^", "start"].includes(JS_ARGS[2]) ? 0 : Number(JS_ARGS[2])}))@
command tabmovealltitle jsb -d@ const dest = JS_ARGS[JS_ARGS.length - 1]; const title = JS_ARGS.slice(1, -1).join(" ").toLowerCase(); browser.tabs.query({currentWindow: true}).then(tabs => browser.tabs.move(tabs.filter(tab => title && tab.title.toLowerCase().includes(title)).map(tab => tab.id), {index: ["$", "end"].includes(dest) ? -1 : ["^", "start"].includes(dest) ? 0 : Number(dest)}))@
command dedup jsb browser.tabs.query({}).then(tabs => { const seenUrls = new Set(); browser.tabs.remove(tabs.filter(tab => seenUrls.has(tab.url) || (seenUrls.add(tab.url), false)).map(tab => tab.id)); })
